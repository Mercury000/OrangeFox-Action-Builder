diff --git a/BoardConfig.mk b/BoardConfig.mk
index 2193f20..253116c 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -59,9 +59,9 @@ BOARD_BOOT_HEADER_VERSION     := 4
 TARGET_KERNEL_CLANG_COMPILE   := true
 BOARD_MKBOOTIMG_ARGS          += --header_version $(BOARD_BOOT_HEADER_VERSION)
 BOARD_MKBOOTIMG_ARGS          += --pagesize $(BOARD_KERNEL_PAGESIZE)
-# Keep the recovery boot header compatible with the vermeer boot chain.
-# PLATFORM_VERSION remains Android 17 for recovery/decryption builds, but a
-# future-version header (17/2099) is rejected by the device's recovery path.
+# Keep boot-image header metadata independent from the recovery decryption
+# platform. These values are only for the verified vermeer boot chain; ROM
+# detection and FBE compatibility use their own runtime/build metadata.
 BOARD_MKBOOTIMG_ARGS          += --os_version 16
 BOARD_MKBOOTIMG_ARGS          += --os_patch_level 2026-08-01
 
@@ -133,7 +133,7 @@ else
 PLATFORM_VERSION := 17
 endif
 PLATFORM_VERSION_LAST_STABLE := $(PLATFORM_VERSION)
-PLATFORM_SECURITY_PATCH := 2026-08-01
+PLATFORM_SECURITY_PATCH := 2099-12-31
 VENDOR_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)
 BOOT_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)
 
@@ -160,6 +160,8 @@ ifeq ($(TW_DEVICE_VERSION),)
 TW_DEVICE_VERSION=POCO_F6_Pro by Lunark
 endif
 RECOVERY_SDCARD_ON_DATA := true
+# Unbind emulated /sdcard before unmounting /data during reboot.
+OF_UNMOUNT_SDCARDS_BEFORE_REBOOT := 1
 TARGET_RECOVERY_QCOM_RTC_FIX := true
 TW_EXCLUDE_DEFAULT_USB_INIT := true
 TW_EXTRA_LANGUAGES := true
@@ -169,7 +171,6 @@ TW_USE_TOOLBOX := true
 TW_INPUT_BLACKLIST := "hbtp_vm"
 TW_BRIGHTNESS_PATH := "/sys/class/backlight/panel0-backlight/brightness"
 TW_MAX_BRIGHTNESS := 2047
-TW_DEFAULT_TIMEZONE := "Asia/Shanghai"
 ifeq ($(TW_DEFAULT_LANGUAGE),)
 TW_DEFAULT_LANGUAGE := zh_CN
 endif
