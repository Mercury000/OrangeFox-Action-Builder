 #ifndef OF_USE_LEGACY_TIME_FIXUP
+#ifdef QCOM_RTC_FIX
+static bool Start_Recovery_Time_Daemon() {
+	struct timeval before, after;
+	gettimeofday(&before, nullptr);
+
+	LOGINFO("TWFunc::Fixup_Time: starting recovery time_daemon before RTC/ATS fixup\n");
+	if (!android::base::SetProperty("ctl.start", "time_daemon")) {
+		LOGERR("TWFunc::Fixup_Time: failed to start recovery time_daemon\n");
+		return false;
+	}
+
+	// The daemon is asynchronous. Accept its result only when it actually
+	// changes the wall clock; a merely valid but stale ATS value is not enough.
+	for (int attempt = 0; attempt < 20; ++attempt) {
+		usleep(250000);
+		gettimeofday(&after, nullptr);
+		long long delta = static_cast<long long>(after.tv_sec) - before.tv_sec;
+		if (delta < 0)
+			delta = -delta;
+		if (after.tv_sec > 1517600000 && delta >= 30) {
+			LOGINFO("TWFunc::Fixup_Time: time_daemon corrected the clock: %s\n", TWFunc::Get_Current_Date().c_str());
+			return true;
+		}
+	}
+
+	LOGERR("TWFunc::Fixup_Time: time_daemon did not correct the clock; refusing stale ATS data\n");
+	return false;
+}
+#endif
+
