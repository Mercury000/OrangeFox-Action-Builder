+# Build the complete FoxFiles payload used by both the update zip and recovery image.
+# The recovery runtime installs this payload from /FFiles/FoxFiles to /sdcard/Fox/FoxFiles.
+prepare_foxfiles_payload() {
+local target="$1"
+local magisk_zip="$FOX_VENDOR_PATH/Files/Magisk.zip"
+
+  [ -z "$target" ] && { echo -e "${WHITEONRED}-- FoxFiles target is empty.${NC}"; return 1; }
+  [ ! -d "$FOX_VENDOR_PATH/FoxFiles" ] && { echo -e "${WHITEONRED}-- Missing vendor FoxFiles directory.${NC}"; return 1; }
+
+  rm -rf "$target"
+  mkdir -p "$target" || return 1
+  $CP -a "$FOX_VENDOR_PATH/FoxFiles/." "$target/" || return 1
+
+  if [ "$FOX_DELETE_AROMAFM" = "1" ]; then
+     echo -e "${GREEN}-- Omitting AromaFM from FoxFiles ...${NC}"
+     rm -rf "$target/AromaFM"
+  fi
+
+  if [ "$FOX_DELETE_INITD_ADDON" = "1" ]; then
+     echo -e "${GREEN}-- Omitting the init.d addon from FoxFiles ...${NC}"
+     rm -f "$target"/OF_initd*.zip
+  fi
+
+  if [ "$FOX_DELETE_MAGISK_ADDON" != "1" ] && [ "$FOX_MOVE_MAGISK_INSTALLER_TO_RAMDISK" != "1" ]; then
+     if [ -n "$FOX_USE_SPECIFIC_MAGISK_ZIP" ]; then
+        if [ -e "$FOX_USE_SPECIFIC_MAGISK_ZIP" ]; then
+           echo -e "${WHITEONGREEN}-- Using magisk zip: \"$FOX_USE_SPECIFIC_MAGISK_ZIP\" ${NC}"
+           magisk_zip="$FOX_USE_SPECIFIC_MAGISK_ZIP"
+        else
+           echo -e "${WHITEONRED}-- I cannot find \"$FOX_USE_SPECIFIC_MAGISK_ZIP\"! Using the default.${NC}"
+        fi
+     fi
+     [ ! -f "$magisk_zip" ] && { echo -e "${WHITEONRED}-- Missing Magisk addon: $magisk_zip${NC}"; return 1; }
+     $CP -pf "$magisk_zip" "$target/Magisk.zip" || return 1
+     $CP -pf "$magisk_zip" "$target/uninstall.zip" || return 1
+  else
+     rm -f "$target/Magisk.zip" "$target/uninstall.zip"
+  fi
+
+  (
+     cd "$target" || exit 1
+     find . -type f ! -name '.foxfiles.sha256' -print0 | LC_ALL=C sort -z | xargs -0 sha256sum > .foxfiles.sha256
+     [ -s .foxfiles.sha256 ] && sha256sum --status -c .foxfiles.sha256
+  ) || return 1
+}
 
