+bool TWFunc::Install_Fox_Files(void) {
+	const string destination = Fox_Home_Files;
+	const string staging = Fox_Home + "/.FoxFiles.installing";
+	const string previous = Fox_Home + "/.FoxFiles.previous";
+
+	if (!FoxFilesPathExists(kFoxFilesSource)) {
+		LOGERR("Embedded FoxFiles payload is missing: %s\n", kFoxFilesSource.c_str());
+		return false;
+	}
+	if (!PartitionManager.Is_Mounted_By_Path("/data") || !PartitionManager.Is_Mounted_By_Path("/sdcard")) {
+		LOGINFO("FoxFiles install deferred until /data and /sdcard are mounted\n");
+		return false;
+	}
+	if (!VerifyFoxFilesTree(kFoxFilesSource))
+		return false;
+
+	if (FoxFilesPathExists(destination) &&
+		FilesHaveSameContents(kFoxFilesSource + "/.foxfiles.sha256", destination + "/.foxfiles.sha256") &&
+		VerifyFoxFilesTree(destination)) {
+		LOGINFO("FoxFiles payload is already current\n");
+		return true;
+	}
+
+	if (!TWFunc::Recursive_Mkdir(Fox_Home)) {
+		LOGERR("Unable to create Fox home directory for FoxFiles\n");
+		return false;
+	}
+	if (!RemoveFoxFilesPath(staging) || !RemoveFoxFilesPath(previous)) {
+		LOGERR("Unable to clear FoxFiles staging paths\n");
+		return false;
+	}
+	if (!CopyFoxFilesTree(kFoxFilesSource, staging) || !VerifyFoxFilesTree(staging)) {
+		LOGERR("Unable to prepare the FoxFiles staging tree\n");
+		RemoveFoxFilesPath(staging);
+		return false;
+	}
+	if (!SetFoxFilesMediaPermissions(staging)) {
+		LOGERR("Unable to apply media permissions to FoxFiles staging tree\n");
+		RemoveFoxFilesPath(staging);
+		return false;
+	}
+
+	const bool had_previous = FoxFilesPathExists(destination);
+	if (had_previous && rename(destination.c_str(), previous.c_str()) != 0) {
+		LOGERR("Unable to stage the previous FoxFiles tree: %s\n", strerror(errno));
+		RemoveFoxFilesPath(staging);
+		return false;
+	}
+	if (rename(staging.c_str(), destination.c_str()) != 0) {
+		LOGERR("Unable to activate the FoxFiles tree: %s\n", strerror(errno));
+		if (had_previous)
+			rename(previous.c_str(), destination.c_str());
+		RemoveFoxFilesPath(staging);
+		return false;
+	}
+	RemoveFoxFilesPath(previous);
+	LOGINFO("Installed embedded FoxFiles payload at %s\n", destination.c_str());
+	return true;
+}
