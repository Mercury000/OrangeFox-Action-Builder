+#ifndef BUILD_TWRPTAR_MAIN
+namespace {
+
+static const string kFoxFilesSource = "/FFiles/FoxFiles";
+
+static bool FoxFilesPathExists(const string& path) {
+	struct stat st;
+	return lstat(path.c_str(), &st) == 0;
+}
+
+static bool RemoveFoxFilesPath(const string& path) {
+	struct stat st;
+	if (lstat(path.c_str(), &st) != 0)
+		return errno == ENOENT;
+	if (S_ISDIR(st.st_mode))
+		return TWFunc::removeDir(path, false) == 0;
+	return unlink(path.c_str()) == 0;
+}
+
+static bool VerifyFoxFilesTree(const string& path) {
+	const string manifest = path + "/.foxfiles.sha256";
+	if (!FoxFilesPathExists(manifest)) {
+		LOGERR("FoxFiles manifest is missing: %s\n", manifest.c_str());
+		return false;
+	}
+	string output;
+	const string command = "cd " + path + " && /system/bin/sha256sum --status -c .foxfiles.sha256";
+	if (TWFunc::Exec_Cmd(command, output, true) != 0) {
+		LOGERR("FoxFiles checksum verification failed for %s: %s\n", path.c_str(), output.c_str());
+		return false;
+	}
+	return true;
+}
+
+static bool FilesHaveSameContents(const string& first, const string& second) {
+	ifstream first_file(first, ios::binary);
+	ifstream second_file(second, ios::binary);
+	if (!first_file.is_open() || !second_file.is_open())
+		return false;
+	ostringstream first_contents;
+	ostringstream second_contents;
+	first_contents << first_file.rdbuf();
+	second_contents << second_file.rdbuf();
+	return first_contents.str() == second_contents.str();
+}
+
+static bool CopyFoxFilesTree(const string& source, const string& destination) {
+	struct stat source_stat;
+	if (lstat(source.c_str(), &source_stat) != 0) {
+		LOGERR("Unable to stat FoxFiles source %s: %s\n", source.c_str(), strerror(errno));
+		return false;
+	}
+
+	if (S_ISDIR(source_stat.st_mode)) {
+		if (mkdir(destination.c_str(), 0775) != 0 && errno != EEXIST) {
+			LOGERR("Unable to create FoxFiles directory %s: %s\n", destination.c_str(), strerror(errno));
+			return false;
+		}
+		DIR* directory = opendir(source.c_str());
+		if (!directory) {
+			LOGERR("Unable to open FoxFiles directory %s: %s\n", source.c_str(), strerror(errno));
+			return false;
+		}
+		bool success = true;
+		struct dirent* entry;
+		while (success && (entry = readdir(directory)) != nullptr) {
+			if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+				continue;
+			const string child_source = source + "/" + entry->d_name;
+			const string child_destination = destination + "/" + entry->d_name;
+			success = CopyFoxFilesTree(child_source, child_destination);
+		}
+		closedir(directory);
+		return success;
+	}
+
+	if (S_ISREG(source_stat.st_mode))
+		return TWFunc::copy_file(source, destination, source_stat.st_mode & 0777, false) == 0;
+
+	if (S_ISLNK(source_stat.st_mode)) {
+		char link_target[PATH_MAX + 1];
+		ssize_t length = readlink(source.c_str(), link_target, PATH_MAX);
+		if (length < 0) {
+			LOGERR("Unable to read FoxFiles symlink %s: %s\n", source.c_str(), strerror(errno));
+			return false;
+		}
+		link_target[length] = '\0';
+		if (symlink(link_target, destination.c_str()) != 0) {
+			LOGERR("Unable to create FoxFiles symlink %s: %s\n", destination.c_str(), strerror(errno));
+			return false;
+		}
+		return true;
+	}
+
+	LOGERR("Unsupported FoxFiles entry: %s\n", source.c_str());
+	return false;
+}
+
+static bool SetFoxFilesMediaPermissions(const string& path) {
+	struct stat file_stat;
+	if (lstat(path.c_str(), &file_stat) != 0)
+		return false;
+
+	bool success = true;
+	if (S_ISDIR(file_stat.st_mode)) {
+		DIR* directory = opendir(path.c_str());
+		if (!directory)
+			return false;
+		struct dirent* entry;
+		while ((entry = readdir(directory)) != nullptr) {
+			if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+				continue;
+			if (!SetFoxFilesMediaPermissions(path + "/" + entry->d_name))
+				success = false;
+		}
+		closedir(directory);
+	}
+
+	if (!S_ISLNK(file_stat.st_mode)) {
+		if (setfilecon(path.c_str(), FOX_MEDIA_RW_DATA_FILE) != 0) {
+			LOGERR("Unable to set FoxFiles SELinux context on %s: %s\n", path.c_str(), strerror(errno));
+			success = false;
+		}
+		if (chown(path.c_str(), AID_MEDIA_RW, AID_MEDIA_RW) != 0) {
+			LOGERR("Unable to set FoxFiles ownership on %s: %s\n", path.c_str(), strerror(errno));
+			success = false;
+		}
+	}
+	return success;
+}
+
+} // namespace
+#endif // ndef BUILD_TWRPTAR_MAIN
